// Microsoft Entra ID SigninLogs: repeated failures against multiple accounts from one IP.
// Adjust thresholds to fit baseline activity; exclude expected test sources only after review.
SigninLogs
| where TimeGenerated >= ago(1h)
| where ResultType != "0"
| summarize FailedAttempts=count(), TargetedUsers=dcount(UserPrincipalName), Users=make_set(UserPrincipalName, 20) by IPAddress
| where FailedAttempts >= 10 and TargetedUsers >= 5
| project IPAddress, FailedAttempts, TargetedUsers, Users
| order by TargetedUsers desc
